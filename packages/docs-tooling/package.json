{
  "name": "@workspace/docs-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Build and migration tooling for the Mintlify docs project in apps/docs. Lives outside apps/docs because Mintlify publishes every .md/.mdx file and injects every .js/.css file found in its root.",
  "type": "module",
  "bin": {
    "docs-tooling": "./bin/docs-tooling.mjs"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "legacy-urls": "tsx src/cli.ts legacy-urls",
    "move": "tsx src/cli.ts move",
    "verify-urls": "tsx src/cli.ts verify-urls",
    "verify-redirects": "tsx src/cli.ts verify-redirects",
    "convert": "tsx src/cli.ts convert",
    "nav:build": "tsx src/cli.ts nav",
    "examples:build": "tsx src/cli.ts examples",
    "mint:validate": "cd ../../apps/docs && npx -y mint@latest validate",
    "mint:dev": "cd ../../apps/docs && npx -y mint@latest dev --port 3003",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run check-types",
    "check-types": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "dependencies": {
    "@workspace/i18n": "workspace:*",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@workspace/config-typescript": "workspace:*",
    "typescript": "5.8.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
