{
  "name": "@workspace/docs-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Build and migration tooling for the Mintlify docs project in apps/docs. Lives outside apps/docs because Mintlify publishes every .md/.mdx file and injects every .js/.css file found in its root.",
  "type": "module",
  "bin": {
    "docs-tooling": "./bin/docs-tooling.mjs"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "legacy-urls": "tsx src/cli.ts legacy-urls",
    "move": "tsx src/cli.ts move",
    "verify-urls": "tsx src/cli.ts verify-urls",
    "verify-redirects": "tsx src/cli.ts verify-redirects",
    "convert": "tsx src/cli.ts convert",
    "nav:build": "tsx src/cli.ts nav build",
    "nav:compile-legacy": "tsx src/cli.ts nav compile-legacy",
    "nav:stubs": "tsx src/cli.ts nav stubs",
    "nav:swap": "tsx src/cli.ts nav swap",
    "nav:verify": "tsx src/cli.ts nav verify",
    "examples:build": "tsx src/cli.ts examples",
    "examples:extract": "tsx src/examples/main.ts extract",
    "gen:surfpool": "tsx src/generators/surfpool-rpc.ts",
    "gen:tags": "tsx src/generators/tags.ts",
    "gen:concepts": "tsx src/generators/concepts.ts",
    "gen:paths": "tsx src/generators/paths.ts",
    "gen:addresses": "tsx src/generators/addresses.ts",
    "gen:manifest": "tsx src/manifest/cli.ts gen:manifest",
    "gen:llms": "tsx src/manifest/cli.ts gen:llms",
    "gen:redirects": "tsx src/manifest/cli.ts gen:redirects",
    "generate": "pnpm run examples:build && pnpm run gen:surfpool && pnpm run gen:paths && pnpm run gen:concepts --sync && pnpm run gen:addresses --sync && pnpm run nav:build && pnpm run gen:tags && pnpm run gen:manifest && pnpm run gen:llms && pnpm run gen:redirects",
    "generate:check": "pnpm run examples:build --check && pnpm run gen:surfpool --check && pnpm run gen:paths --check && pnpm run gen:concepts --check && pnpm run gen:addresses --check && pnpm run nav:build --check && pnpm run gen:tags --check && pnpm run gen:manifest --check && pnpm run gen:llms --check && pnpm run gen:redirects --check",
    "residual": "tsx src/cli.ts residual",
    "verify": "tsx src/cli.ts verify",
    "theme-check": "node scripts/theme-check.mjs",
    "diagrams:mermaid": "tsx scripts/render-mermaid.ts",
    "diagrams:themes": "node scripts/sync-diagram-themes.mjs",
    "diagrams:fonts": "python3 scripts/embed-diagram-fonts.py",
    "mint:validate": "cd ../../apps/docs && npx -y mint@latest validate",
    "mint:dev": "cd ../../apps/docs && npx -y mint@latest dev --port 3003",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run check-types",
    "check-types": "tsc --noEmit",
    "clean": "node ../../scripts/clean.mjs ."
  },
  "dependencies": {
    "@sindresorhus/slugify": "2.2.1",
    "@workspace/i18n": "workspace:*",
    "github-slugger": "2.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tsx": "^4.22.4",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@workspace/config-typescript": "workspace:*",
    "playwright": "1.58.2",
    "typescript": "5.8.3",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
