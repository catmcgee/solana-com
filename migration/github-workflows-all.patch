diff --git a/.github/workflows/surfpool-schema-drift.yml b/.github/workflows/surfpool-schema-drift.yml
new file mode 100644
index 0000000..93dfcd4
--- /dev/null
+++ b/.github/workflows/surfpool-schema-drift.yml
@@ -0,0 +1,110 @@
+name: Docs — Surfpool schema drift
+
+# Weekly check that the Surfpool RPC reference
+# (apps/docs/snippets/rpc/surfpool/*.mdx, imported by
+# developers/docs/tools/surfpool/rpc/* in every locale) still matches upstream.
+#
+# Upstream: solana-foundation/surfpool-web-ui, apps/docs/src/data/*.json.
+# The local copies in packages/docs-tooling/data/surfpool carry solana.com
+# edits, so the sync is a 3-way merge (base = the upstream commit recorded in
+# data/surfpool/upstream.json) that keeps them, then the snippets are
+# regenerated (src/generators/surfpool-rpc.ts --sync).
+#
+# Report-only: per the migration decisions no pull request is opened and
+# nothing is pushed. When upstream moved, the run fails and uploads
+# surfpool-schema-drift.patch; apply it with `git apply`, or run the same
+# command locally:
+#   pnpm --filter @workspace/docs-tooling exec tsx src/generators/surfpool-rpc.ts --sync --ref main
+#
+# SURFPOOL_SCHEMA_REF is the surfpool-web-ui ref to compare against. It is
+# deliberately not SURFPOOL_REF, which docs-examples.yml uses to pin the
+# surfpool binary from a different repository.
+
+on:
+  schedule:
+    # Mondays at 07:00 UTC (after docs-examples deps drift).
+    - cron: "0 7 * * 1"
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: surfpool-web-ui ref (branch, tag or commit) to sync to
+        required: false
+        default: main
+
+permissions:
+  contents: read
+
+env:
+  SURFPOOL_SCHEMA_REF: ${{ inputs.ref || vars.SURFPOOL_SCHEMA_REF || 'main' }}
+
+jobs:
+  drift:
+    name: Surfpool schema drift
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: pnpm/action-setup@v6
+        with:
+          run_install: false
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version-file: .node-version
+          cache: "pnpm"
+
+      # Root install: the generator formats its output with the repo's pinned
+      # oxfmt (the same formatter lint-staged runs on commit).
+      - name: Install deps
+        run: pnpm install --frozen-lockfile
+
+      - name: Committed snippets match committed schemas
+        run:
+          pnpm --filter @workspace/docs-tooling exec tsx
+          src/generators/surfpool-rpc.ts --check
+
+      - name: Merge upstream schemas and regenerate snippets
+        env:
+          GITHUB_TOKEN: ${{ github.token }}
+        run:
+          pnpm --filter @workspace/docs-tooling exec tsx
+          src/generators/surfpool-rpc.ts --sync --ref "$SURFPOOL_SCHEMA_REF"
+
+      - name: Report drift
+        id: drift
+        run: |
+          paths="packages/docs-tooling/data/surfpool apps/docs/snippets/rpc/surfpool"
+          git add --intent-to-add -- $paths
+          if git diff --quiet -- $paths; then
+            echo "No Surfpool schema drift against \`$SURFPOOL_SCHEMA_REF\`." >> "$GITHUB_STEP_SUMMARY"
+            echo "drift=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          git diff --binary -- $paths > surfpool-schema-drift.patch
+          {
+            echo "## Surfpool schema drift"
+            echo
+            echo "Upstream \`solana-foundation/surfpool-web-ui@$SURFPOOL_SCHEMA_REF\` changed since the recorded base."
+            echo
+            echo '```'
+            git diff --stat -- $paths
+            echo '```'
+            echo
+            echo "Download the \`surfpool-schema-drift\` artifact and run \`git apply surfpool-schema-drift.patch\`,"
+            echo "or run \`pnpm --filter @workspace/docs-tooling exec tsx src/generators/surfpool-rpc.ts --sync --ref $SURFPOOL_SCHEMA_REF\` locally."
+          } >> "$GITHUB_STEP_SUMMARY"
+          echo "drift=true" >> "$GITHUB_OUTPUT"
+
+      - name: Upload drift patch
+        if: steps.drift.outputs.drift == 'true'
+        uses: actions/upload-artifact@v4
+        with:
+          name: surfpool-schema-drift
+          path: surfpool-schema-drift.patch
+          retention-days: 30
+
+      - name: Fail on drift
+        if: steps.drift.outputs.drift == 'true'
+        run: |
+          echo "::error::Surfpool schemas drifted from upstream; see the job summary."
+          exit 1
