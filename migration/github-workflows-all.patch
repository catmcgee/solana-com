@@ -0,0 +1,93 @@
+name: Docs
+
+# Repo-side checks for the developer docs content in apps/docs, which apps/web
+# renders with Fumadocs. `docs-tooling verify` runs every content check
+# (residual syntax, nav coverage, legacy URL parity, frontmatter, assets,
+# generator freshness, convert --check); the apps/web docs tests follow.
+# Report-only: no pull requests are opened.
+
+on:
+  pull_request:
+    branches: [main, docs-redesign]
+    paths:
+      - "apps/docs/**"
+      - "packages/docs-tooling/**"
+      - "apps/web/source.config.ts"
+      - "apps/web/rewrites-redirects.ts"
+      - "apps/web/scripts/copy-docs-static.mjs"
+      - "apps/web/src/app/**/developers/docs/**"
+      - "apps/web/src/components/docs/**"
+      - "apps/web/src/lib/docs/**"
+      - "apps/web/src/lib/docs-edge/**"
+      - "packages/sitemap/**"
+      - "migration/move-map.csv"
+      - ".github/workflows/docs.yml"
+  push:
+    branches: [main, docs-redesign]
+    paths:
+      - "apps/docs/**"
+      - "packages/docs-tooling/**"
+      - "apps/web/source.config.ts"
+      - "apps/web/rewrites-redirects.ts"
+      - "apps/web/src/app/**/developers/docs/**"
+      - "apps/web/src/components/docs/**"
+      - "apps/web/src/lib/docs/**"
+      - "apps/web/src/lib/docs-edge/**"
+      - ".github/workflows/docs.yml"
+
+permissions:
+  contents: read
+
+jobs:
+  docs-tooling:
+    name: Docs tooling
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+        with:
+          # legacy-urls / verify-urls read the pre-migration tree from git.
+          fetch-depth: 0
+
+      - name: Install pnpm
+        uses: pnpm/action-setup@v6
+        with:
+          run_install: false
+
+      - name: Install Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version-file: .node-version
+          cache: "pnpm"
+
+      - name: Install Safe Chain
+        run: |
+          npm install --global @aikidosec/safe-chain
+          safe-chain setup-ci
+
+      # Also runs apps/web's postinstall (fumadocs-mdx), which generates the
+      # Fumadocs collections from apps/docs.
+      - name: Install dependencies
+        run: pnpm install --frozen-lockfile
+
+      - name: Type check
+        run: pnpm --filter @workspace/docs-tooling check-types
+
+      # Includes test/rpc.test.ts (param counts, leftover RPC syntax,
+      # Surfpool method coverage).
+      - name: Unit and fixture tests
+        run: pnpm --filter @workspace/docs-tooling test
+
+      # residual syntax = 0, nav:verify exact coverage, verify-urls 100%,
+      # frontmatter, assets, every generator --check (generate:check:
+      # examples, surfpool, paths, concepts, addresses, nav:build, tags,
+      # manifest/llms/redirects) and convert --check.
+      - name: docs-tooling verify
+        run: pnpm --filter @workspace/docs-tooling verify
+
+      - name:
+          apps/web docs routing (rewrites, redirects, middleware, llms, sitemap)
+        run: pnpm --filter solana-com exec vitest run src/__tests__/routes
+
+      - name: apps/web docs chrome
+        run: pnpm --filter solana-com exec vitest run src/__tests__/developers
