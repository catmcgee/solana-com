@@ -0,0 +1,93 @@
+name: Docs (Mintlify)
+
+# Spec §4.4 (WP12 integration). `docs-tooling verify` runs every repo-side
+# check (residual syntax, nav coverage, legacy URL parity, frontmatter,
+# assets, generator freshness, convert --check); the Mintlify CLI checks
+# follow. Report-only: no pull requests are opened (decisions.md).
+
+on:
+  pull_request:
+    branches: [main, mintlify-migration]
+    paths:
+      - "apps/docs/**"
+      - "packages/docs-tooling/**"
+      - "apps/web/rewrites-redirects.ts"
+      - "apps/web/src/lib/docs-edge/**"
+      - "packages/sitemap/**"
+      - "migration/move-map.csv"
+      - ".github/workflows/docs-mintlify.yml"
+  push:
+    branches: [main, mintlify-migration]
+    paths:
+      - "apps/docs/**"
+      - "packages/docs-tooling/**"
+      - "apps/web/rewrites-redirects.ts"
+      - "apps/web/src/lib/docs-edge/**"
+      - ".github/workflows/docs-mintlify.yml"
+
+permissions:
+  contents: read
+
+jobs:
+  docs-tooling:
+    name: Docs tooling
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout repository
+        uses: actions/checkout@v4
+        with:
+          # legacy-urls / verify-urls read the pre-migration tree from git.
+          fetch-depth: 0
+
+      - name: Install pnpm
+        uses: pnpm/action-setup@v6
+        with:
+          run_install: false
+
+      - name: Install Node.js
+        uses: actions/setup-node@v4
+        with:
+          node-version-file: .node-version
+          cache: "pnpm"
+
+      - name: Install Safe Chain
+        run: |
+          npm install --global @aikidosec/safe-chain
+          safe-chain setup-ci
+
+      - name: Install dependencies
+        run: pnpm install --frozen-lockfile
+
+      - name: Type check
+        run: pnpm --filter @workspace/docs-tooling check-types
+
+      # Includes test/rpc.test.ts, the WP4 acceptance gate (param counts,
+      # leftover RPC syntax, Surfpool method coverage).
+      - name: Unit and fixture tests
+        run: pnpm --filter @workspace/docs-tooling test
+
+      # residual syntax = 0, nav:verify exact coverage, verify-urls 100%,
+      # frontmatter, assets, every generator --check (examples, surfpool,
+      # paths, concepts, addresses, nav:build, tags, manifest/llms/redirects)
+      # and convert --check (converted + idempotent).
+      - name: docs-tooling verify (spec §4.4)
+        run: pnpm --filter @workspace/docs-tooling verify
+
+      - name: apps/web docs routing (rewrites, redirects, middleware, llms, sitemap)
+        run: pnpm --filter solana-com exec vitest run src/__tests__/routes
+
+      - name: Mintlify validate
+        working-directory: apps/docs
+        run: npx -y mint@latest validate
+
+      - name: Mintlify broken links (pages, snippets, redirects)
+        working-directory: apps/docs
+        run: npx -y mint@latest broken-links --check-snippets --check-redirects
+
+      # Anchors are reported, not blocking: 466 in-content fragments were
+      # already dead on the legacy site (translated headings in stale locale
+      # forks, removed sections); the `anchors` transform warns about each.
+      - name: Mintlify broken anchors (report)
+        working-directory: apps/docs
+        continue-on-error: true
+        run: npx -y mint@latest broken-links --check-anchors
