# WP9-edge: turbo.json changes for apps/web (solana-com). Apply with: git apply migration/wp9-edge-turbo.patch
# 1. MINTLIFY_ORIGIN replaces NEXT_PUBLIC_DOCS_APP_URL in solana-com#build/#test env (strict env mode would otherwise drop it and it would not be in the cache key).
# 2. apps/docs pages + packages/docs-tooling/generated are build inputs, so vercel-ignore.mjs (turbo query affected) rebuilds apps/web when docs content changes (locale-fallback rewrites, /docs/<section>/llms.txt, sitemap).
diff --git a/turbo.json b/turbo.json
index eecda94f8..69e40b8b6 100644
--- a/turbo.json
+++ b/turbo.json
@@ -17,9 +17,9 @@
         "ANALYZE",
         "DATA_API_URL",
         "DVP_DEMO_RPC_URL",
+        "MINTLIFY_ORIGIN",
         "NEXT_PUBLIC_ACCELERATE_APP_URL",
         "NEXT_PUBLIC_BREAKPOINT_APP_URL",
-        "NEXT_PUBLIC_DOCS_APP_URL",
         "NEXT_PUBLIC_MEDIA_APP_URL",
         "NEXT_PUBLIC_POSTHOG_KEY",
         "NEXT_PUBLIC_RPC_ENDPOINT",
@@ -40,7 +40,11 @@
       "inputs": [
         "$TURBO_DEFAULT$",
         ".env*",
-        "$TURBO_ROOT$/packages/config-typescript/**"
+        "$TURBO_ROOT$/packages/config-typescript/**",
+        "$TURBO_ROOT$/apps/docs/**/*.md",
+        "$TURBO_ROOT$/apps/docs/**/*.mdx",
+        "$TURBO_ROOT$/apps/docs/docs.json",
+        "$TURBO_ROOT$/packages/docs-tooling/generated/**"
       ],
       "outputs": [".next/**", "!.next/cache/**", "dist/**"],
       "passThroughEnv": [
@@ -233,9 +237,9 @@
     "solana-com#test": {
       "dependsOn": ["^build", "^test"],
       "env": [
+        "MINTLIFY_ORIGIN",
         "NEXT_PUBLIC_ACCELERATE_APP_URL",
         "NEXT_PUBLIC_BREAKPOINT_APP_URL",
-        "NEXT_PUBLIC_DOCS_APP_URL",
         "NEXT_PUBLIC_MEDIA_APP_URL",
         "NEXT_PUBLIC_TEMPLATES_APP_URL",
         "NODE_ENV",
@@ -243,7 +247,11 @@
       ],
       "inputs": [
         "$TURBO_DEFAULT$",
-        "$TURBO_ROOT$/packages/config-typescript/**"
+        "$TURBO_ROOT$/packages/config-typescript/**",
+        "$TURBO_ROOT$/apps/docs/**/*.md",
+        "$TURBO_ROOT$/apps/docs/**/*.mdx",
+        "$TURBO_ROOT$/apps/docs/docs.json",
+        "$TURBO_ROOT$/packages/docs-tooling/generated/**"
       ],
       "passThroughEnv": ["CI"],
       "outputs": []
