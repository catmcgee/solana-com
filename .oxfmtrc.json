{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "all",
  "semi": true,
  "printWidth": 80,
  "endOfLine": "lf",
  "proseWrap": "always",
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["**/*.mdx"],
      "options": {
        "trailingComma": "none"
      }
    },
    {
      "files": ["apps/media/**/*.mdx"],
      "options": {
        "printWidth": 100,
        "proseWrap": "preserve",
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    "apps/docs/**/*.mdx",
    "apps/docs/**/*.md",
    "apps/docs/navigation/**",
    "apps/docs/docs.json",
    "apps/docs/redirects.json",
    "packages/docs-tooling/generated/**",
    "packages/docs-tooling/__fixtures__/**",
    "migration/**",
    ".github/*.md",
    "public",
    ".vercel",
    ".next",
    "**/.next",
    ".turbo",
    "dist",
    "coverage",
    "playwright-report",
    "apps/web/content/**/meta.json",
    ".claude",
    ".cursor",
    ".codex",
    ".gstack",
    ".secrets-migration",
    ".ralph",
    "RALPH_TASK.md",
    "turbo/generators/templates",
    "packages/i18n/messages/*/*",
    "!packages/i18n/messages/*/en",
    "packages/docs-tooling/__fixtures__",
    "apps/docs/ar",
    "apps/docs/de",
    "apps/docs/es",
    "apps/docs/fi",
    "apps/docs/fr",
    "apps/docs/id",
    "apps/docs/it",
    "apps/docs/ja",
    "apps/docs/ko",
    "apps/docs/nl",
    "apps/docs/pl",
    "apps/docs/pt",
    "apps/docs/ru",
    "apps/docs/tr",
    "apps/docs/uk",
    "apps/docs/vi",
    "apps/docs/zh",
    "apps/media/content/posts/**/*.mdx",
    "apps/web/content/docs/*/rpc/**"
  ]
}
