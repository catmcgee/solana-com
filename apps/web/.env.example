# YouTube
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=
# Simplecast
SIMPLECAST_PODCAST_ID=
SIMPLECAST_API_KEY=
# LUMA
LUMA_PRIVATE_API_KEY=
# RPC Endpoint
NEXT_PUBLIC_RPC_ENDPOINT=
## Server-only Inkeep key for search, chat, and analytics proxying
INKEEP_API_KEY=
# Docs "Ask AI" assistant. Server-only: the docs agent's base URL and the
# shared secret /api/ask sends it. Without both, /api/ask answers 503.
ASK_AGENT_URL=
ASK_SOLANA_PROXY_SECRET=
# Set to 1 to answer /api/ask from a built-in mock (canned answers, no agent).
# Ignored on production deployments (VERCEL_ENV=production).
ASK_SOLANA_MOCK=
# Which backend answers /api/ask: agent (default), nous or mock. nous and mock
# are review backends, ignored on production. Unset: ASK_SOLANA_MOCK decides.
ASK_SOLANA_BACKEND=
# nous backend: a model on the Nous inference gateway, grounded in the docs.
# Server-only key; never expose it as NEXT_PUBLIC_*. Without it, 503. Use a
# key of its own with a spend cap. On Vercel: only a project whose deployment
# protection covers every domain (ssoProtection "all"), with the WAF rate
# limit rule `ask-ai-nous-chat` (nous-agent.ts). Locally, `next dev` listens on
# every interface: with the key set, run it with `-H 127.0.0.1`.
# Optional: WAF rule id for the nous rate limit, or "off" on a review project
# whose deployment protection covers every domain (the check would otherwise
# need a protection bypass secret on previews).
ASK_NOUS_WAF_RULE=
NOUS_API_KEY=
# Optional: gateway base URL (https only) and model id.
NOUS_BASE_URL=https://inference-api.nousresearch.com/v1
ASK_NOUS_MODEL=z-ai/glm-5.3-flash:US
# Posthog
NEXT_PUBLIC_POSTHOG_KEY=
# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_SUPPRESS_GLOBAL_ERROR_HANDLER_FILE_WARNING=1
# Media app URL
NEXT_PUBLIC_MEDIA_APP_URL=
# Breakpoint app URL
NEXT_PUBLIC_BREAKPOINT_APP_URL=

# Data API metrics route (data.solana.com) -- base URL includes the API
# Gateway's /v1 stage; the custom domain does not strip it.
DATA_API_URL=https://data.solana.com/v1
DATA_API_KEY=

# RPC latency Grafana Cloud Prometheus data route
RPC_LATENCY_GRAFANA_BASE_URL=https://rpclatency.grafana.net/api/datasources/proxy/uid/grafanacloud-prom
RPC_LATENCY_GRAFANA_API_TOKEN=

# RWA.xyz API
RWA_XYZ_API_TOKEN=

# Full RPC endpoint; any provider is supported.
SOLANA_RPC_URL=

# Delivery-versus-Payment devnet demo RPC and treasury. Server-only.
DVP_DEMO_RPC_URL=
DVP_DEMO_TREASURY_SECRET=

# "Solana in action" demo wallets (devnet, JSON byte arrays). Server-only.
DEMO_PAYER_SECRET_KEY=
DEMO_PAYEE_SECRET_KEY=

# University Ambassador application (empty sheets initialize response headers on first submission)
# Configure the Vercel Firewall rate-limit ID `university-ambassador-submit` in the project dashboard.
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
UNIVERSITY_AMBASSADOR_GOOGLE_SHEET_ID=
UNIVERSITY_AMBASSADOR_GOOGLE_SHEET_RANGE=
