{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Solana Developer Docs",
  "description": "Developer documentation for Solana: payments, assets, markets, how Solana works, programs, tools and the JSON-RPC API.",
  "colors": {
    "primary": "#9945FF",
    "light": "#C4A1FF",
    "dark": "#7A2FE0"
  },
  "logo": {
    "light": "/docs-assets/brand/solana-developers-logo-on-light.svg",
    "dark": "/docs-assets/brand/solana-developers-logo-on-dark.svg",
    "href": "/developers"
  },
  "favicon": "/docs-assets/brand/favicon.svg",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0B"
    }
  },
  "fonts": {
    "heading": {
      "family": "ABC Diatype",
      "weight": 500,
      "source": "fonts/ABCDiatype-Medium.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "ABC Diatype",
      "weight": 400,
      "source": "fonts/ABCDiatype-Regular.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark-dimmed"
      }
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/solana",
