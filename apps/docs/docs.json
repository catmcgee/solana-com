  "seo": {
    "indexing": "all",
    "metatags": {
      "canonical": "https://solana.com",
      "og:site_name": "Solana",
      "twitter:site": "@solana",
      "twitter:card": "summary_large_image",
      "robots": "noindex, nofollow"
